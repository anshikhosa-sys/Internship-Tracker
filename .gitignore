# ---------------------------------------------------------------------------
# Files git should ignore.
#
# Two rules of thumb for what belongs here:
#   1. Anything rebuildable from the code (caches, compiled files, the venv).
#   2. Anything personal or machine-specific (your database, editor settings).
#
# Everything else — the code that defines the project — gets committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PERSONAL — never commit. This repo is public.
# ---------------------------------------------------------------------------

# Your résumé, in the form the letter generator reads. Contains your name,
# contact details, and work history. profile_example.md is the committed
# template; profile.md is yours and stays local.
profile.md

# Real user profiles (parsed résumé + preferences). Only the synthetic
# example is committed.
profiles/*
!profiles/example.json

# Real relevance labels and eval baselines are derived from a person's
# applications. Only the synthetic example set is committed.
eval/golden/*
!eval/golden/example.jsonl
eval/baselines/*
!eval/baselines/example.json

# Private working notes that name the author.
BRIEFING.md
HANDOFF-CHANGES.md

# Generated cover letter drafts. They quote your résumé and are written in
# your name — keep them off the internet.
letters/

# Anything holding an API key.
.env
.env.*

# Your database. Contains your applied marks, and is otherwise rebuildable
# with `python3 refresh.py`. Back it up separately if you've been tracking
# applications for a while:  cp internships.db internships.db.backup
internships.db
applications.db
applications.json
*.db-journal
*.backup

# The virtual environment. Never commit this — it's hundreds of files, it's
# specific to one machine and OS, and it's fully reproducible from
# requirements.txt.
.venv/
venv/
env/

# Downloaded embedding models, LLM response caches, vector indexes.
.cache/

# Python's compiled bytecode cache. Regenerated automatically.
__pycache__/
*.py[cod]
*.egg-info/

# Editor and OS clutter
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code's machine-local settings (your own permission choices).
# By convention, .claude/settings.json IS shared and settings.local.json isn't.
.claude/settings.local.json

# Logs from the scheduled daily refresh.
logs/

# Playwright's downloaded browsers live in ~/Library/Caches, but its test
# artifacts land here.
test-results/
playwright-report/
